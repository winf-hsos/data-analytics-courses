{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/course-assistant.md"
  ],
  "model": "opencode/space-bunny-free",
  "small_model": "opencode/space-bunny-free",
  "enabled_providers": [
    "openai",
    "opencode"
  ],
  "share": "disabled",
  "permission": {
    "edit": {
      "*": "ask",
      "*my-code/about-me.md": "allow",
      "*my-code\\about-me.md": "allow"
    },
    "bash": {
      "*": "ask",
      "*Rscript* --version": "allow",
      "Get-ChildItem *": "allow",
      "*Rscript*.opencode/scripts/systemcheck.R*": "allow",
      "*Rscript*.opencode/scripts/update_course.R*": "allow",
      "*Rscript*.opencode\\scripts\\systemcheck.R*": "allow",
      "*Rscript*.opencode\\scripts\\update_course.R*": "allow",
      "*Rscript*.opencode/scripts/run_script.R my-code/*": "allow",
      "*Rscript*.opencode\\scripts\\run_script.R my-code*": "allow",
      "*quarto* --version": "allow",
      "winget --version": "allow",
      "brew --version": "allow"
    }
  }
}
